# Template; provision secrets locally, chmod 600. Never commit completed file.
WA_HA_ENABLED=true
WA_HA_DATABASE_URL=postgresql://NODE_LOGIN:SECRET@DB_HOST:5432/postgres
WA_HA_FENCER_DATABASE_URL=postgresql://NODE_FENCER_LOGIN:SECRET@DB_HOST:5432/postgres
WA_HA_CA_FILE=/etc/wa-ha/db-ca.pem
WA_HA_CURRENT_KID=initial
WA_HA_KEYRING_JSON={"initial":"BASE64_32_RANDOM_BYTES"}
WA_HA_OPERATOR_ALERT_URL=https://APPROVED_OPERATOR_ENDPOINT
WA_HA_OPERATOR_ALERT_TOKEN=SECRET
WA_HA_HETZNER_TOKEN=SECRET
# Production: omit WA_HA_LOCAL_TEST and WA_HA_SUPERVISED (launcher sets the latter).
