PORT=3001
# Hostname Traefik routes to this service (compose only; must match DNS)
WA_HOST=wa.otomator.pro
API_SECRET=change_this_to_a_random_secret_32chars
PARTNER_REGISTRATION_KEY=generate-a-strong-secret-here
# Comma-separated. Include every Jumpstart URL that calls /status or embeds /connect in an iframe (local + prod).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://hub.jumpstart.co.il
LOG_LEVEL=info
NODE_ENV=production
SUPABASE_URL=https://mzalzjtsyrjycaxolldv.supabase.co
SUPABASE_SERVICE_KEY=                              # Get from Supabase Dashboard → Settings → API → service_role key

# Jumpstart platform (wa_devices heartbeat / reconcile / outage alerts)
JUMPSTART_SUPABASE_URL=https://dgxnnwnugdxzeopleera.supabase.co
JUMPSTART_SUPABASE_SERVICE_KEY=                    # Jumpstart service_role key

# Session monitoring alerts (default on). Set to 0/false/off to disable.
# WA_SESSION_ALERTS=1
# WA_ALERT_TO_PHONE=972528393669
# WA_ALERT_FROM_SESSION_KEY=c3aa7a0d-461a-4ed4-882a-58bd063b1e62-d1fde265
# WA_HEARTBEAT_INTERVAL_MS=60000
# WA_OUTAGE_ALERT_MS=600000

# Inbound webhook auth for Edge Function wa-incoming (Hub/Otomator).
# Required when session webhookUrl has no ?secret= query param.
# Must match the EF's WA_INCOMING_SECRET (or API_SECRET) — never commit the real value.
# WA_INCOMING_SECRET=

# Half-open socket probe interval (ms) while status=connected. Default 25000.
# WA_KEEPALIVE_INTERVAL_MS=25000

# Inbound media cache (sessions/<orgId>/media) — hand-off buffer before Hub R2 upload.
# Files older than this TTL are deleted on startup and every 6 hours. Default 7.
# WA_MEDIA_TTL_DAYS=7

# Meta Cloud API — Template management + webhook verification
META_APP_SECRET=                                   # Meta App Dashboard → Settings → Basic → App Secret
META_GRAPH_BASE=https://graph.facebook.com/v21.0   # Graph API base URL (override for testing)
